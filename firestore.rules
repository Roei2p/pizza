rules_version = '2';

// Small single-restaurant app, not a multi-tenant SaaS — rules here are kept
// intentionally simple rather than enterprise-grade. Nothing stored is more
// sensitive than what a customer already tells the pizzeria over the phone
// (name/phone/address); the one thing genuinely protected is "who can see
// every order" (only Sharon, via Auth) and "who can move an order forward"
// (also only Sharon).
service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      // Anyone holding a specific order id (the customer, from their own
      // tracker link) can read that one order — a `get`. Listing/querying
      // the whole collection (Sharon's live dashboard) requires being
      // signed in as her.
      allow get: if true;
      allow list: if request.auth != null;

      // A customer creates their own order, always starting at 'received'.
      allow create: if request.resource.data.status == 'received'
                    && request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string
                    && request.resource.data.items is list;

      // Only Sharon (signed in) advances an order's status.
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /customers/{phone} {
      // Keyed by phone number, which the customer types themselves — this
      // is how "recognize me on another device" works without a login.
      allow read, write: if true;
    }
  }
}
