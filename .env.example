# Gemini API key, for the customer chatbot, personalized suggestions, and
# Sharon's dashboard assistant. Get a free one at
# https://aistudio.google.com/apikey — called directly from the browser
# (no backend proxy), so it's visible in the site's JS bundle. That's a
# known, accepted tradeoff for a small free-tier key; see src/lib/gemini.ts.
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase (orders backend + Sharon's live dashboard). Get these from
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup
# and configuration. Safe to expose client-side (not secrets) — access is
# controlled by firestore.rules, not by hiding this config.
# Leave unset to run against the local Firebase emulator (see README/CLAUDE
# notes) with no real project needed.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Set to "true" to force the app to talk to local Firebase emulators
# (firestore:8080, auth:9099) instead of a real project, even if the
# VITE_FIREBASE_* vars above are filled in. Defaults to true automatically
# in `bun run dev` when no project id is set.
VITE_USE_FIREBASE_EMULATOR=""
